# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Remember to allow your IP under Atlas > Network Access.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/shopease?retryWrites=true&w=majority

# Any long random string. Signs the session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# The admin account created by `npm run seed`.
ADMIN_NAME=ShopEase Admin
ADMIN_EMAIL=admin@shopease.test
ADMIN_PASSWORD=replace-with-a-strong-password

# Transactional emails (optional — defaults to clean simulated console logs in development)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="ShopEase" <orders@shopease.test>
